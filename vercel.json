{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "dist/app.js": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/dist/app.js" },
    { "source": "/(.*)",     "destination": "/dist/app.js" }
  ]
}
